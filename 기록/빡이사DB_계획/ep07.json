 "captions": [
  {
   "from": 1342.18,
   "to": 1343.24,
   "text": "더 확실한 의향"
  },
  {
   "from": 1343.24,
   "to": 1345.78,
   "text": "이게 기본값으로 아마 체크가 돼 있을 건데"
  },
  {
   "from": 1345.78,
   "to": 1348.14,
   "text": "더 많은 제출 수로 변경을 해 주시면 돼요",
   "hl": "더 많은 제출 수"
  },
  {
   "from": 1348.14,
   "to": 1349.78,
   "text": "이거 하시면 문의 넣을 때마다"
  },
  {
   "from": 1349.78,
   "to": 1351.08,
   "text": "인증 번호 받아야 하는데"
  },
  {
   "from": 1351.08,
   "to": 1353.76,
   "text": "조금 더 DB 질 자체는 좋아지겠죠?"
  },
  {
   "from": 1353.76,
   "to": 1356.46,
   "text": "하지만 수집하는 게 꽤 어렵기 때문에"
  },
  {
   "from": 1356.46,
   "to": 1357.78,
   "text": "하지 말라고 하는 거고"
  },
  {
   "from": 1357.78,
   "to": 1359.08,
   "text": "지금 그러면 빡이사님은"
  },
  {
   "from": 1359.08,
   "to": 1360.2,
   "text": "허수 DB 뽑는 것만"
  },
  {
   "from": 1360.2,
   "to": 1361.92,
   "text": "알려 주시는 분 아니야? 하시는데"
  },
  {
   "from": 1361.92,
   "to": 1363.7,
   "text": "이거 아셔야 할 게 여러분들"
  },
  {
   "from": 1363.7,
   "to": 1365.74,
   "text": "광고 돌리고 계신 분이 아니라"
  },
  {
   "from": 1365.74,
   "to": 1367.23,
   "text": "처음 돌리시는 분들이잖아요"
  },
  {
   "from": 1367.23,
   "to": 1369.31,
   "text": "광고 계정도 학습을 해요"
  },
  {
   "from": 1369.31,
   "to": 1370.73,
   "text": "어느 정도 DB가 쌓이고"
  },
  {
   "from": 1370.73,
   "to": 1372.45,
   "text": "데이터가 쌓이면 광고 계정도"
  },
  {
   "from": 1372.45,
   "to": 1373.83,
   "text": "아하, 이 광고주는"
  },
  {
   "from": 1373.83,
   "to": 1375.37,
   "text": "이런 사람 좋아하는구나"
  },
  {
   "from": 1375.37,
   "to": 1378.17,
   "text": "오케이 하면서 알아서 잘 찾아간단 말이에요"
  },
  {
   "from": 1378.17,
   "to": 1380.83,
   "text": "근데 아무런 학습 데이터가 없는 상태에서"
  },
  {
   "from": 1380.83,
   "to": 1382.99,
   "text": "애초부터 퍼널을 빡빡하게 만들면"
  },
  {
   "from": 1382.99,
   "to": 1384.63,
   "text": "이 학습이 너무 더뎌요",
   "hl": "너무 더뎌요"
  },
  {
   "from": 1384.63,
   "to": 1386.63,
   "text": "그래서 돈을 천 원 쓸 거를"
  },
  {
   "from": 1386.63,
   "to": 1388.41,
   "text": "한 만 원을 더 써야 한다라고만",
   "hl": "만 원"
  },
  {
   "from": 1388.41,
   "to": 1389.85,
   "text": "이해를 하시면 될 것 같아요"
  }
 ],
