 "captions": [
  {
   "from": 1913.43,
   "to": 1917.12,
   "text": "메타 광고 라이브러리 검색을 해보세요",
   "hl": "메타 광고 라이브러리"
  },
  {
   "from": 1917.12,
   "to": 1919.52,
   "text": "그러면 광고 라이브러리라고 뜰 거예요"
  },
  {
   "from": 1919.52,
   "to": 1920.76,
   "text": "이거 들어가시면"
  },
  {
   "from": 1920.76,
   "to": 1922.8,
   "text": "이렇게 이런 화면이 나올 겁니다"
  },
  {
   "from": 1922.8,
   "to": 1924.99,
   "text": "이게 메타에서 돌아가고 있는"
  },
  {
   "from": 1924.99,
   "to": 1925.97,
   "text": "모든 광고를 다",
   "hl": "모든 광고"
  },
  {
   "from": 1925.97,
   "to": 1927.45,
   "text": "취합을 해주고 있는 거거든요"
  },
  {
   "from": 1935.8,
   "to": 1937.33,
   "text": "그러면 이렇게 다른 사람들이"
  },
  {
   "from": 1937.33,
   "to": 1939.17,
   "text": "지금 돌리고 있는 광고"
  },
  {
   "from": 1939.17,
   "to": 1942.14,
   "text": "기본 문구, 사진, 제목, 더 알아보기 버튼"
  },
  {
   "from": 1942.14,
   "to": 1943.28,
   "text": "이거 그대로 구조 다"
  },
  {
   "from": 1943.28,
   "to": 1944.5,
   "text": "나와 있는 거 보이시나요?"
  },
  {
   "from": 1944.5,
   "to": 1947.16,
   "text": "좋은 광고 레퍼런스를 보는 법은 뭔가요?",
   "hl": "좋은 광고 레퍼런스"
  },
  {
   "from": 1947.16,
   "to": 1949.12,
   "text": "8월 21일에 게재 시작함",
   "hl": "8월 21일"
  },
  {
   "from": 1949.12,
   "to": 1950.78,
   "text": "5월 29일에 게재 시작함",
   "hl": "5월 29일"
  },
  {
   "from": 1950.78,
   "to": 1952.08,
   "text": "이 날짜 보이시나요?"
  },
  {
   "from": 1952.08,
   "to": 1956.04,
   "text": "세상에 어떤 바보가 성과가 좋지 않은 광고를"
  },
  {
   "from": 1956.04,
   "to": 1957.74,
   "text": "오래 켜고 있을까요?",
   "hl": "오래"
  },
  {
   "from": 1957.74,
   "to": 1958.72,
   "text": "뭔 말인지 이해되세요?"
  },
  {
   "from": 1958.72,
   "to": 1960.35,
   "text": "일단 오래 돌렸다"
  },
  {
   "from": 1960.35,
   "to": 1961.23,
   "text": "라고 되어 있으면"
  },
  {
   "from": 1961.23,
   "to": 1962.55,
   "text": "검증이 된 광고입니다",
   "hl": "검증"
  },
  {
   "from": 1962.55,
   "to": 1964.09,
   "text": "그런데 내가 봤을 때"
  },
  {
   "from": 1964.09,
   "to": 1965.87,
   "text": "아- 이 광고 진짜 누가 봐도"
  },
  {
   "from": 1965.87,
   "to": 1967.09,
   "text": "너무 안 좋은 것 같은데?"
  },
  {
   "from": 1967.09,
   "to": 1968.57,
   "text": "이거를 이렇게 돌린다고?"
  },
  {
   "from": 1968.57,
   "to": 1971.49,
   "text": "여러분들 여러분들의 눈에 만족하는 게"
  },
  {
   "from": 1971.49,
   "to": 1972.39,
   "text": "올바른 게 아니라"
  },
  {
   "from": 1972.39,
   "to": 1975.15,
   "text": "데이터가 밀어주는 것을 보셔야 합니다",
   "hl": "데이터"
  },
  {
   "from": 1975.15,
   "to": 1976.89,
   "text": "오래전부터 돌아가고 있는 광고는"
  },
  {
   "from": 1976.89,
   "to": 1979.61,
   "text": "일단 기본적으로 잘 되는 광고이기 때문에"
  },
  {
   "from": 1979.61,
   "to": 1981.55,
   "text": "이렇게 돌아가고 있는 걸 거거든요"
  },
  {
   "from": 1981.55,
   "to": 1982.77,
   "text": "그래서 이런 것들의 레퍼런스를"
  },
  {
   "from": 1982.77,
   "to": 1983.97,
   "text": "우리가 빌려오면 되겠죠?",
   "hl": "빌려오면"
  }
 ],
