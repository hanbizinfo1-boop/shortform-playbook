 "captions": [
  {
   "from": 440.3,
   "to": 442.44,
   "text": "웹사이트는 아무래도 문의를 넣기 전에"
  },
  {
   "from": 442.44,
   "to": 444.08,
   "text": "내 웹사이트를 클릭을 해서"
  },
  {
   "from": 444.08,
   "to": 446.36,
   "text": "웹사이트에 대한 콘텐츠를 한번 살펴보고"
  },
  {
   "from": 446.36,
   "to": 448.66,
   "text": "인지를 하고 문의를 넣기 때문에"
  },
  {
   "from": 448.66,
   "to": 449.92,
   "text": "DB 수집하는 것 자체는"
  },
  {
   "from": 449.92,
   "to": 451.28,
   "text": "조금 더 어려울 수 있어요",
   "hl": "어려울"
  },
  {
   "from": 451.28,
   "to": 453.14,
   "text": "하지만 DB가 들어왔을 때"
  },
  {
   "from": 453.14,
   "to": 455.12,
   "text": "계약 전환율로 봤을 때는"
  },
  {
   "from": 455.12,
   "to": 457.15,
   "text": "아무래도 조금 더 계약 전환이"
  },
  {
   "from": 457.15,
   "to": 458.7,
   "text": "잘 되는 경우들이 많아요",
   "hl": "잘 되는"
  },
  {
   "from": 458.7,
   "to": 460.83,
   "text": "그런데 인스턴트 양식 같은 경우에는",
   "hl": "인스턴트 양식"
  },
  {
   "from": 460.83,
   "to": 462.83,
   "text": "그냥 딱 누르면 폼이 올라오고"
  },
  {
   "from": 462.83,
   "to": 464.57,
   "text": "그 폼 빠르게 입력해서"
  },
  {
   "from": 464.57,
   "to": 465.77,
   "text": "넘어갈 수 있다 보니까"
  },
  {
   "from": 465.77,
   "to": 467.59,
   "text": "DB 수집 자체는 쉽거든요",
   "hl": "쉽거든요"
  },
  {
   "from": 467.59,
   "to": 469.17,
   "text": "하지만 허수 DB가",
   "hl": "허수 DB"
  },
  {
   "from": 469.17,
   "to": 470.73,
   "text": "어느 정도는 섞여 있다"
  },
  {
   "from": 470.73,
   "to": 471.97,
   "text": "라고 이해를 하면 되는데"
  },
  {
   "from": 471.97,
   "to": 475.37,
   "text": "아직 내가 스스로 DB를 뽑아보지 않았다"
  },
  {
   "from": 475.37,
   "to": 477.33,
   "text": "랜딩 페이지부터 바로 돌리지 마시고",
   "hl": "돌리지 마시고"
  },
  {
   "from": 477.33,
   "to": 479.77,
   "text": "무조건 인스턴트로 DB 먼저 뽑아보시고",
   "hl": "인스턴트로 DB 먼저"
  },
  {
   "from": 479.77,
   "to": 480.77,
   "text": "통화해 보시고"
  },
  {
   "from": 480.77,
   "to": 482.55,
   "text": "아 어떻게 내가 해야겠다"
  },
  {
   "from": 482.55,
   "to": 484.53,
   "text": "라는 이 구조부터 파악을 하시고"
  },
  {
   "from": 484.53,
   "to": 486.43,
   "text": "랜딩으로 넘어가시는 거를"
  },
  {
   "from": 486.43,
   "to": 487.47,
   "text": "권장을 드리는 게 아니라"
  },
  {
   "from": 487.47,
   "to": 488.53,
   "text": "그냥 이렇게 하십시오",
   "hl": "이렇게 하십시오"
  },
  {
   "from": 488.53,
   "to": 489.37,
   "text": "이게 맞습니다"
  },
  {
   "from": 489.37,
   "to": 491.44,
   "text": "돈 버는 이 퍼널을 쭉 보면은"
  },
  {
   "from": 491.44,
   "to": 492.92,
   "text": "수강생 많이 키워봤잖아요"
  },
  {
   "from": 492.92,
   "to": 495.68,
   "text": "항상 인스턴트 안 하시고 랜딩부터 돌리시면"
  },
  {
   "from": 495.68,
   "to": 497.46,
   "text": "어차피 세일즈하고 이런 부분에 있어서"
  },
  {
   "from": 497.46,
   "to": 498.72,
   "text": "좀 부족한 게 많고"
  },
  {
   "from": 498.72,
   "to": 500.52,
   "text": "DB 관리라든가 이런 것들이 부족해서"
  },
  {
   "from": 500.52,
   "to": 502.4,
   "text": "계약 안 나오는 경우 허다하거든요",
