 "captions": [
  {
   "from": 697.85,
   "to": 700.01,
   "text": "언어 부분에 항상 어떻게 한다?"
  },
  {
   "from": 700.01,
   "to": 701.98,
   "text": "한국어로 하셔야 합니다",
   "hl": "한국어"
  },
  {
   "from": 701.98,
   "to": 704.1,
   "text": "왜? 모든 언어로 하면 안 되는 이유는"
  },
  {
   "from": 704.1,
   "to": 705.02,
   "text": "아주 간단한데"
  },
  {
   "from": 707.01,
   "to": 710.03,
   "text": "대한민국에 살고 있는 사람 중에"
  },
  {
   "from": 710.03,
   "to": 712.67,
   "text": "페이스북이나 인스타그램을 하는 사람들이"
  },
  {
   "from": 712.67,
   "to": 714.82,
   "text": "일본어든 영어든 중국어든"
  },
  {
   "from": 714.82,
   "to": 716.48,
   "text": "상관없이 다 노출해 주세요"
  },
  {
   "from": 716.48,
   "to": 718.04,
   "text": "라고 하는 거랑 똑같은 거거든요"
  },
  {
   "from": 718.04,
   "to": 720.32,
   "text": "그래서 대한민국에 있지만"
  },
  {
   "from": 720.32,
   "to": 723.1,
   "text": "우리 페이스북이나 인스타 쓰는 그 언어가"
  },
  {
   "from": 723.1,
   "to": 725.68,
   "text": "한국어인 사람한테만 노출해 주세요",
   "hl": "한국어인 사람한테만"
  },
  {
   "from": 725.68,
   "to": 727.56,
   "text": "라고 하는 게 언어 세팅이라고"
  },
  {
   "from": 727.56,
   "to": 728.97,
   "text": "이해를 하시면 될 것 같고"
  },
  {
   "from": 728.97,
   "to": 730.97,
   "text": "여기서 잠시 한 가지만 좀 알려드리면"
  },
  {
   "from": 730.97,
   "to": 732.89,
   "text": "우리가 검색 광고 같은 경우에는"
  },
  {
   "from": 732.89,
   "to": 735.21,
   "text": "클릭당 비용이 발생을 하는 구조잖아요"
  },
  {
   "from": 740.5,
   "to": 742.0,
   "text": "그런데 메타 광고나"
  },
  {
   "from": 742.0,
   "to": 743.24,
   "text": "유튜브 구글 애즈 같은"
  },
  {
   "from": 743.24,
   "to": 744.97,
   "text": "유튜브 쇼츠 광고 이런 거 있잖아요"
  },
  {
   "from": 744.97,
   "to": 747.93,
   "text": "이런 것들은 노출당 비용으로 산정을 해요",
   "hl": "노출당 비용"
  },
  {
   "from": 747.93,
   "to": 749.45,
   "text": "중국인한테 광고가 가든"
  },
  {
   "from": 749.45,
   "to": 751.05,
   "text": "일본인한테 광고가 가든"
  },
  {
   "from": 751.05,
   "to": 753.13,
   "text": "상관없이 과금이 된다는 뜻이에요"
  },
  {
   "from": 753.13,
   "to": 754.8,
   "text": "메타에서 우리가 잘하려면"
  },
  {
   "from": 754.8,
   "to": 758.22,
   "text": "최대한 노출을 이상한 데 안 하는 걸 막아야 합니다",
   "hl": "막아야"
  }
 ],
